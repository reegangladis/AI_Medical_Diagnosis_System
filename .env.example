# =============================================================
# AI Healthcare Diagnosis System — Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to version control.

# ---------------------------
# Flask Core Settings
# ---------------------------
# Required: Generate a strong random key → python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secure_random_secret_key_here

# Set to "production" for live deployments, "development" for local
FLASK_ENV=production

# ---------------------------
# Database (PostgreSQL)
# ---------------------------
# Leave blank to use local SQLite (for local dev only)
# Format: postgresql://username:password@host:port/dbname
# Render auto-injects this if you link a PostgreSQL service
DATABASE_URL=

# ---------------------------
# AI / LLM API Keys
# ---------------------------
# Google Gemini API key (primary AI doctor chat)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ---------------------------
# Maps / Location Services
# ---------------------------
# Google Maps API key (for hospital directions)
# Get yours at: https://console.cloud.google.com/apis
GOOGLE_MAPS_API_KEY=

# ---------------------------
# ML Model Storage (Optional)
# ---------------------------
# If using Render Persistent Disk or custom path, set absolute path to models directory.
# Leave blank to use the default ./models/ folder relative to the app.
# Example: /var/data/models
MODELS_DIR=
